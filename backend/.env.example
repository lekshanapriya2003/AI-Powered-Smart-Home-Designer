# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL (local install). Create the database first, or let init_db.py do it.
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/smart_home_designer

# LLM keys (used from Phase 2)
# Get a Gemini key at https://aistudio.google.com/apikey and a Groq key at https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

# Image generation. Cloudflare: dash.cloudflare.com -> AI -> Workers AI -> Use REST API.
# Pollinations.ai needs no key and is used automatically as the fallback.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Where generated images are saved on disk (relative to backend/)
IMAGE_DIR=generated_images

# Frontend dev server origin, allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173
